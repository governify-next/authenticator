GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=authenticator
PORT=5900
MONGO_URI=mongodb://localhost:27017/governify-next

# Default admin user
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Default service clients
SCOPE_MANAGER_CLIENT_SECRET=scope_manager_client_secret
REGISTRY_CLIENT_SECRET=registry_client_secret
COMPUTER_CLIENT_SECRET=computer_client_secret
FETCHER_CLIENT_SECRET=fetcher_client_secret
REPORTER_CLIENT_SECRET=reporter_client_secret
DIRECTOR_CLIENT_SECRET=director_client_secret

# JWT configuration
JWT_SECRET=governify_next_secret_key
JWT_ISSUER=authenticator
JWT_AUDIENCE=governify-next
JWT_USER_EXPIRES_IN=15m
JWT_USER_JWT_USER_REFRESH_TOKEN_DAYS=7
JWT_SERVICE_EXPIRES_IN=15m

# OpenID Connect configuration
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5900/api/v1/users/oidc/callback
OIDC_SCOPE=openid email profile
